{
  "name": "kitapligim-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "mobile:prepare": "node scripts/prepare-mobile.mjs",
    "mobile:add:android": "npm run mobile:prepare && npx cap add android",
    "mobile:add:ios": "npm run mobile:prepare && npx cap add ios",
    "mobile:sync": "npm run mobile:prepare && npx cap sync",
    "mobile:open:android": "npx cap open android",
    "mobile:open:ios": "npx cap open ios",
    "mobile:build:bridge": "esbuild mobile/quote-scanner.ts --bundle --format=iife --platform=browser --outfile=www/mobile-quote-scanner.js"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@pantrist/capacitor-plugin-ml-kit-text-recognition": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "esbuild": "^0.25.0"
  }
}
